# Copy to .env; do not commit .env
POSTGRES_PASSWORD=change-me-to-a-strong-local-password
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# OIDC_ISSUER must match the exact iss claim of your external IdP.
OIDC_ISSUER=https://idp.example.org/realms/aiplatform
# This JWKS endpoint MUST be reachable from API and MCP containers.
OIDC_JWKS_URL=https://idp.example.org/realms/aiplatform/protocol/openid-connect/certs
OIDC_AUDIENCE=aiplatform-api
# Optional collector endpoint (traces): http://otel-collector:4318/v1/traces
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
